{
  "name": "twenty-e2e-testing",
  "projectType": "application",
  "tags": ["scope:testing"],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright install",
          "cp .env.example .env"
        ]
      }
    },
    "start:isolated-uat": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "yarn tsx packages/twenty-e2e-testing/scripts/start-isolated-uat.ts"
      }
    },
    "test:startup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "yarn tsx --test packages/twenty-e2e-testing/scripts/start-isolated-uat.test.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn tsx --test scripts/start-isolated-uat.test.ts",
          "yarn playwright test"
        ]
      }
    },
    "test:ui": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test --ui"
        ]
      }
    },
    "test:debug": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright test --debug"
        ]
      }
    },
    "test:report": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/twenty-e2e-testing",
        "commands": [
          "yarn playwright show-report"
        ]
      }
    }
  }
}
