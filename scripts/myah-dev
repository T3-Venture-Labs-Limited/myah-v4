#!/usr/bin/env bash
# One-command local Myah environment per worktree.
#
#   scripts/myah-dev up [--reset]   start Postgres/Redis containers, API, worker and frontend
#   scripts/myah-dev up --from-prod copy production (read-only) instead of seeding, then run the
#                                   startup upgrade production runs; sign in with a production
#                                   email and password myah-dev (needs `railway login`)
#   scripts/myah-dev down           stop everything and delete this environment's data
#   scripts/myah-dev restart [api|worker|front]   restart one process (the worker does not hot-reload)
#   scripts/myah-dev status         show URLs and process state
#   scripts/myah-dev logs [api|worker|front]
#
# Each worktree gets its own containers, ports and .env files, so several can run at once.
# Postgres matches production's major version (MYAH_DEV_PG_IMAGE overrides it).
# Data is disposable: `up --reset` (or the first `up`) recreates the schema and seeds the
# demo workspace. Login: tim@apple.dev / tim@apple.dev.
#
# Real sends stay off: Instagram (Unipile) and Gmail providers are disabled and email uses
# the logger driver unless you override them in ~/.config/myah-dev/env.
# Extra variables (e.g. AI provider keys) in ~/.config/myah-dev/env are appended to the
# server .env.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
NAME="$(basename "$ROOT" | tr -c 'a-zA-Z0-9-\n' '-')"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/myah-dev/$NAME"
EXTRA_ENV="${MYAH_DEV_EXTRA_ENV:-$HOME/.config/myah-dev/env}"

# ponytail: hash-based port slots, may collide across ~200 worktrees; `up` checks ports first.
SLOT=$(( $(printf '%s' "$NAME" | cksum | cut -d' ' -f1) % 200 ))
BASE=$(( 42000 + SLOT * 10 ))
PG_PORT=$BASE REDIS_PORT=$((BASE + 1)) API_PORT=$((BASE + 2)) FRONT_PORT=$((BASE + 3))
PG="myah-dev-$NAME-pg"
PG_IMAGE="${MYAH_DEV_PG_IMAGE:-postgres:18}"
PROD_PROJECT="${MYAH_PROD_RAILWAY_PROJECT:-myah-v3}"
PROD_DB_SERVICE="${MYAH_PROD_RAILWAY_DB_SERVICE:-Postgres-rWX3}"
PROD_PASSWORD=myah-dev
REDIS="myah-dev-$NAME-redis"

# Node from .nvmrc (via mise when available) and the Yarn pinned in package.json (via corepack).
NODE_VERSION="$(cat "$ROOT/.nvmrc")"
yarn_cmd() {
  if command -v mise >/dev/null; then echo mise exec "node@$NODE_VERSION" -- corepack yarn; else echo corepack yarn; fi
}
run_yarn() { (cd "$ROOT" && $(yarn_cmd) "$@"); }

port_busy() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

running() { [ -f "$STATE/$1.pid" ] && kill -0 "$(cat "$STATE/$1.pid")" 2>/dev/null; }

# Per-process memory caps (override with MYAH_DEV_MEM_API/WORKER/FRONT). Each process runs
# in its own systemd scope so hitting a cap kills only that process, never the terminal or
# agent session that started it.
mem_cap() {
  case $1 in
    api) echo "${MYAH_DEV_MEM_API:-7G}" ;;
    worker) echo "${MYAH_DEV_MEM_WORKER:-2G}" ;;
    front) echo "${MYAH_DEV_MEM_FRONT:-6G}" ;;
  esac
}

start_bg() { # name, command...
  local name=$1; shift
  running "$name" && return 0
  cd "$ROOT"
  local scope=()
  if [ -n "${XDG_RUNTIME_DIR:-}" ] && command -v systemd-run >/dev/null; then
    scope=(systemd-run --user --scope --quiet --collect --unit="myah-dev-$NAME-$name-$$"
      -p MemoryMax="$(mem_cap "$name")" -p MemorySwapMax=0)
  fi
  "${scope[@]}" setsid nohup "$@" >"$STATE/$name.log" 2>&1 </dev/null &
  echo $! >"$STATE/$name.pid"
}

stop_bg() {
  running "$1" && kill -- "-$(cat "$STATE/$1.pid")" 2>/dev/null || true
  rm -f "$STATE/$1.pid"
}

wait_http() { # url, seconds
  for _ in $(seq 1 "$2"); do curl -sf -o /dev/null "$1" && return 0; sleep 1; done
  return 1
}

write_env() {
  # Keep one secret per environment: data encrypted with it (signing keys, tokens)
  # must stay readable across restarts.
  local secret
  [ -s "$STATE/app-secret" ] || (umask 077 && openssl rand -hex 24 >"$STATE/app-secret")
  secret=$(cat "$STATE/app-secret")
  {
    grep -v -E '^(PG_DATABASE_URL|REDIS_URL|APP_SECRET|NODE_PORT|SERVER_URL|FRONTEND_URL)=' \
      "$ROOT/packages/twenty-server/.env.example"
    cat <<EOF
PG_DATABASE_URL=postgres://postgres:postgres@localhost:$PG_PORT/default
REDIS_URL=redis://localhost:$REDIS_PORT
APP_SECRET=$secret
NODE_PORT=$API_PORT
SERVER_URL=http://localhost:$API_PORT
FRONTEND_URL=http://localhost:$FRONT_PORT
UNIPILE_INSTAGRAM_ENABLED=false
MESSAGING_PROVIDER_GMAIL_ENABLED=false
MESSAGING_PROVIDER_MICROSOFT_ENABLED=false
EMAIL_DRIVER=logger
EOF
    # A production copy has several workspaces: use production's subdomain routing
    # (app.localhost, <workspace>.localhost) so each one is reachable.
    if [ "${FROM_PROD:-}" = 1 ]; then
      printf 'IS_MULTIWORKSPACE_ENABLED=true\nDEFAULT_SUBDOMAIN=app\n'
    fi
    [ -f "$EXTRA_ENV" ] && cat "$EXTRA_ENV"
  } >"$ROOT/packages/twenty-server/.env"
  printf 'REACT_APP_SERVER_BASE_URL=http://localhost:%s\nREACT_APP_PORT=%s\n' \
    "$API_PORT" "$FRONT_PORT" >"$ROOT/packages/twenty-front/.env"
}

up() {
  local reset=${1:-}
  mkdir -p "$STATE"

  # A production copy must restore into production's Postgres major version.
  if [ "$reset" = --from-prod ] && docker inspect "$PG" >/dev/null 2>&1 &&
    [ "$(docker inspect -f '{{.Config.Image}}' "$PG")" != "$PG_IMAGE" ]; then
    stop_bg api; stop_bg worker
    docker rm -f "$PG" >/dev/null
  fi

  if ! docker inspect "$PG" >/dev/null 2>&1; then
    port_busy "$PG_PORT" && { echo "Port $PG_PORT is in use; stop whatever uses it or rename the worktree." >&2; exit 1; }
    docker run -d --name "$PG" --label myah-dev="$NAME" -p "127.0.0.1:$PG_PORT:5432" \
      -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=default "$PG_IMAGE" >/dev/null
    [ "$reset" = --from-prod ] || reset=--reset
  fi
  if ! docker inspect "$REDIS" >/dev/null 2>&1; then
    port_busy "$REDIS_PORT" && { echo "Port $REDIS_PORT is in use; stop whatever uses it or rename the worktree." >&2; exit 1; }
    docker run -d --name "$REDIS" --label myah-dev="$NAME" -p "127.0.0.1:$REDIS_PORT:6379" \
      redis:7 --maxmemory-policy noeviction >/dev/null
  fi
  docker start "$PG" "$REDIS" >/dev/null
  until docker exec "$PG" pg_isready -U postgres >/dev/null 2>&1; do sleep 1; done

  FROM_PROD=
  if [ "$reset" = --from-prod ] || { [ "$reset" != --reset ] && [ -f "$STATE/from-prod" ]; }; then
    FROM_PROD=1
  fi
  write_env
  [ -d "$ROOT/node_modules" ] || run_yarn install

  if [ "$reset" = --reset ]; then
    echo "Resetting database and seeding the demo workspace..."
    stop_bg api; stop_bg worker
    run_yarn nx database:reset twenty-server >"$STATE/reset.log" 2>&1 ||
      { echo "database:reset failed, see $STATE/reset.log" >&2; exit 1; }
  fi

  if [ "$reset" = --from-prod ]; then
    stop_bg api; stop_bg worker
    restore_prod
  elif [ "$reset" = --reset ]; then
    rm -f "$STATE/from-prod"
  fi

  start_bg api $(yarn_cmd) nx start twenty-server
  echo "Waiting for the API (first start builds the server)..."
  wait_http "http://localhost:$API_PORT/healthz" 600 ||
    { echo "API did not start, see $STATE/api.log" >&2; exit 1; }
  start_worker
  start_bg front $(yarn_cmd) nx start twenty-front
  wait_http "http://localhost:$FRONT_PORT" 300 || echo "Frontend still starting, see $STATE/front.log" >&2
  status
}

# Production copy: a read-only dump restored into this environment's database, then the same
# cache flush + upgrade production runs on startup, so pending upgrade steps run against real
# data before they reach production. Sends stay off (see write_env), production secrets do not
# decrypt with the local APP_SECRET, and every user's password becomes $PROD_PASSWORD.
# The copy holds real customer data: it stays in this machine's container; `down` deletes it.
restore_prod() {
  command -v railway >/dev/null || { echo "Install the Railway CLI and run railway login." >&2; exit 1; }
  local url
  url=$(railway variables -p "$PROD_PROJECT" -e production -s "$PROD_DB_SERVICE" --json |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["DATABASE_PUBLIC_URL"])') ||
    { echo "Could not read the production database URL from Railway." >&2; exit 1; }
  echo "Copying production (read-only)..."
  docker exec -e PGOPTIONS="-c default_transaction_read_only=on" "$PG" \
    pg_dump "$url" -Fc --no-owner --no-acl -f /var/tmp/prod.dump
  docker exec "$PG" psql -U postgres -q -c 'DROP DATABASE IF EXISTS "default" WITH (FORCE)' -c 'CREATE DATABASE "default"'
  docker exec "$PG" pg_restore -U postgres -d default --no-owner --no-acl /var/tmp/prod.dump ||
    { echo "Restore reported errors; check before trusting this copy." >&2; }
  docker exec "$PG" rm -f /var/tmp/prod.dump
  local hash
  hash=$(cd "$ROOT/packages/twenty-server" && $(yarn_cmd) node -e \
    "console.log(require('bcrypt').hashSync('$PROD_PASSWORD', 10))")
  docker exec "$PG" psql -U postgres -d default -q -c \
    "UPDATE core.\"user\" SET \"passwordHash\" = '$hash' WHERE \"deletedAt\" IS NULL" \
    -c 'DELETE FROM core."signingKey"' # encrypted with production's secret; regenerated locally
  docker exec "$REDIS" redis-cli flushall >/dev/null
  echo "Running the production startup upgrade (build, cache flush, upgrade)..."
  run_yarn nx build twenty-server >"$STATE/upgrade.log" 2>&1 &&
    (cd "$ROOT/packages/twenty-server" && NODE_ENV=development $(yarn_cmd) node dist/command/command.js cache:flush &&
      NODE_ENV=development $(yarn_cmd) node dist/command/command.js upgrade &&
      NODE_ENV=development $(yarn_cmd) node dist/command/command.js cache:flush) >>"$STATE/upgrade.log" 2>&1 ||
    { echo "Upgrade failed on the production copy, see $STATE/upgrade.log" >&2; exit 1; }
  grep -E "Upgrade summary" "$STATE/upgrade.log" | tail -1
  date -u +%FT%TZ >"$STATE/from-prod"
}

# The worker runs the API watcher's compiled output instead of a second watch compiler
# (each `nest start --watch` holds ~5 GB). Use `restart worker` after changing worker code.
start_worker() {
  start_bg worker env -C "$ROOT/packages/twenty-server" NODE_ENV=development \
    node dist/queue-worker/queue-worker.js
}

restart() {
  case "${1:-}" in
    api) stop_bg api; start_bg api $(yarn_cmd) nx start twenty-server ;;
    worker) stop_bg worker; start_worker ;;
    front) stop_bg front; start_bg front $(yarn_cmd) nx start twenty-front ;;
    *) echo "usage: myah-dev restart api|worker|front" >&2; exit 1 ;;
  esac
}

down() {
  stop_bg front; stop_bg worker; stop_bg api
  docker rm -f "$PG" "$REDIS" >/dev/null 2>&1 || true
  rm -rf "$STATE"
  echo "Stopped $NAME and deleted its data."
}

status() {
  echo "Environment: $NAME"
  if [ -f "$STATE/from-prod" ]; then
    echo "  App:    http://app.localhost:$FRONT_PORT  (production copy from $(cat "$STATE/from-prod"); production email / $PROD_PASSWORD)"
  else
    echo "  App:    http://localhost:$FRONT_PORT  (login tim@apple.dev / tim@apple.dev)"
  fi
  echo "  API:    http://localhost:$API_PORT"
  echo "  DB:     postgres://postgres:postgres@localhost:$PG_PORT/default"
  echo "  Redis:  redis://localhost:$REDIS_PORT"
  for p in api worker front; do
    if running "$p"; then echo "  $p: running (log $STATE/$p.log)"; else echo "  $p: stopped"; fi
  done
}

case "${1:-}" in
  up) up "${2:-}" ;;
  down) down ;;
  status) status ;;
  restart) restart "${2:-}" ;;
  logs) tail -n 100 -f "$STATE/${2:-api}.log" ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
